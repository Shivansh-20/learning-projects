        except ValueError # as error: why this
            print("error")
            return
        if args.command == "add":
            task_test = " ".join(args.task)
            new_task = add_task(data, task_test)
            save_tasks(data)
            print(f"Task added with id {new_task['id']}")
        elif args.command == "list":
            tasks = list_tasks(data, args.status)
            if tasks:
                for task in tasks:
                    print("task")
                else:
                    print("nothing to show")
        elif args.command == "delete":
            deleted_task = delete_tasks(data, args.task_id)
            if deleted_task is None:
                print("Task not found")
            else:
                save_tasks(data)
                print("task deleted successfully")

    
